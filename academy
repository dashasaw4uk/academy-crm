<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Академія Руху CRM</title>
<style>
body{font-family:Arial;margin:0;background:#f4f6f8;color:#222}
header{background:#1f3b4d;color:white;padding:15px 20px;font-size:20px}
.container{display:flex;min-height:100vh}
nav{width:220px;background:#263845;color:white;padding:10px}
nav button{width:100%;margin:5px 0;padding:10px;border:none;background:#34495e;color:white;cursor:pointer;border-radius:6px}
nav button:hover{background:#3d5f77}
main{flex:1;padding:20px}
.card{background:white;padding:15px;border-radius:10px;margin-bottom:15px;box-shadow:0 2px 5px rgba(0,0,0,0.1)}
input,select{padding:8px;margin:5px 0;width:100%}
.row{display:flex;gap:10px}
.row > div{flex:1}
table{width:100%;border-collapse:collapse}
th,td{border:1px solid #ddd;padding:8px;text-align:left;font-size:14px}
th{background:#eee}
button.action{padding:5px 8px;font-size:12px}
.small{font-size:12px;color:#666}
.badge{padding:3px 6px;border-radius:5px;color:white;font-size:11px}
.red{background:#e74c3c}
.green{background:#2ecc71}
.orange{background:#f39c12}
</style>
</head>
<body>

<header>Академія Руху — CRM система</header>

<div class="container">
<nav>
<button onclick="show('dashboard')">Головна</button>
<button onclick="show('visitors')">Відвідувачі</button>
<button onclick="show('trainers')">Тренери</button>
<button onclick="show('calendar')">Календар</button>
</nav>

<main>

<div id="dashboard" class="view">
<div class="card">
<h2>Dashboard</h2>
<div id="stats"></div>
</div>
<div class="card">
<h3>Сьогодні відсутні</h3>
<div id="todayAbsent"></div>
</div>
<div class="card">
<h3>Нагадування (завтра кінець заморозки)</h3>
<div id="reminders"></div>
</div>
</div>

<div id="visitors" class="view" style="display:none">
<div class="card">
<h2>Додати відвідувача</h2>
<input id="v_name" placeholder="Ім'я">
<input id="v_surname" placeholder="Прізвище">

<select id="v_trainer1"></select>
<select id="v_trainer2"></select>

<select id="v_type">
<option>Шрот-терапія</option>
<option>Функціональні</option>
</select>

<select id="v_format">
<option>Групове</option>
<option>Індивідуальне</option>
<option>Змішане</option>
</select>

<h4>Графік</h4>
<div id="scheduleBox"></div>

<button onclick="addVisitor()">Додати</button>
</div>

<div class="card">
<h2>Список відвідувачів</h2>
<div id="visitorList"></div>
</div>
</div>

<div id="trainers" class="view" style="display:none">
<div class="card">
<h2>Тренери</h2>
<input id="t_name" placeholder="Ім'я тренера">
<button onclick="addTrainer()">Додати</button>
</div>
<div class="card">
<div id="trainerList"></div>
</div>
</div>

<div id="calendar" class="view" style="display:none">
<div class="card">
<h2>Перевірка відсутніх</h2>
<input type="date" id="checkDate">
<button onclick="checkAbsent()">Показати</button>
<div id="calendarResult"></div>
</div>
</div>

</main>
</div>

<script>
let visitors = JSON.parse(localStorage.getItem("visitors")||"[]");
let trainers = JSON.parse(localStorage.getItem("trainers")||"[]");

function save(){
localStorage.setItem("visitors",JSON.stringify(visitors));
localStorage.setItem("trainers",JSON.stringify(trainers));
}

function show(v){
document.querySelectorAll(".view").forEach(x=>x.style.display="none");
document.getElementById(v).style.display="block";
renderAll();
}

function addTrainer(){
let n=document.getElementById("t_name").value;
if(!n)return;
trainers.push({id:Date.now(),name:n});
document.getElementById("t_name").value="";
save();
renderAll();
}

function renderTrainers(){
let sel1=document.getElementById("v_trainer1");
let sel2=document.getElementById("v_trainer2");
sel1.innerHTML="<option>Різні</option>";
sel2.innerHTML="<option>Різні</option>";
trainers.forEach(t=>{
sel1.innerHTML+=`<option value="${t.name}">${t.name}</option>`;
sel2.innerHTML+=`<option value="${t.name}">${t.name}</option>`;
});
let list=document.getElementById("trainerList");
list.innerHTML=trainers.map(t=>`<div>${t.name}</div>`).join("");
}

function addVisitor(){
let v={
id:Date.now(),
name:v_name.value,
surname:v_surname.value,
t1:v_trainer1.value,
t2:v_trainer2.value,
type:v_type.value,
format:v_format.value,
schedule:getSchedule(),
freezes:[]
};
visitors.push(v);
save();
renderAll();
}

function getSchedule(){
let arr=[];
document.querySelectorAll(".sch").forEach(s=>{
if(s.checked){
arr.push({day:s.value,time:document.getElementById("time_"+s.value).value});
}
});
return arr;
}

function renderSchedule(){
let days=["Пн","Вт","Ср","Чт","Пт","Сб","Нд"];
let box=document.getElementById("scheduleBox");
box.innerHTML="";
days.forEach(d=>{
box.innerHTML+=`
<div>
<label><input type="checkbox" class="sch" value="${d}"> ${d}</label>
<input id="time_${d}" placeholder="час">
</div>`;
});
}

function renderVisitors(){
let list=document.getElementById("visitorList");
list.innerHTML=visitors.map(v=>{
return `<div class='card'>
<b>${v.name} ${v.surname}</b><br>
${v.t1||""} ${v.t2||""}<br>
${v.type} | ${v.format}<br>
<button onclick="freeze(${v.id})">Заморозка</button>
</div>`;
}).join("");
}

function freeze(id){
let from=prompt("З дати (YYYY-MM-DD)");
let to=prompt("По дату (YYYY-MM-DD)");
let v=visitors.find(x=>x.id==id);
if(!v)return;
v.freezes.push({from,to});
save();
renderAll();
}

function isFrozen(v,date){
return v.freezes.some(f=>date>=f.from && date<=f.to);
}

function checkAbsent(){
let d=document.getElementById("checkDate").value;
let res=document.getElementById("calendarResult");
let list=visitors.filter(v=>isFrozen(v,d));
res.innerHTML=list.map(v=>v.name+" "+v.surname).join("<br>");
}

function renderDashboard(){
let today=new Date().toISOString().slice(0,10);
let tomorrow=new Date(Date.now()+86400000).toISOString().slice(0,10);

let todayAbsent=visitors.filter(v=>isFrozen(v,today));
document.getElementById("todayAbsent").innerHTML=todayAbsent.map(v=>v.name+" "+v.surname).join("<br>");

let reminders=[];
visitors.forEach(v=>{
v.freezes.forEach(f=>{
if(f.to===tomorrow){
reminders.push(v.name+" "+v.surname);
}
});
});
document.getElementById("reminders").innerHTML=reminders.join("<br>");

document.getElementById("stats").innerHTML=
"Відвідувачів: "+visitors.length+"<br>Тренерів: "+trainers.length;
}

function renderAll(){
renderTrainers();
renderSchedule();
renderVisitors();
renderDashboard();
}

renderAll();
</script>

</body>
</html>
